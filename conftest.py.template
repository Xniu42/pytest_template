# --- 7. pytest-html Reporting Hooks ---
# This section is self-contained and generally does not need project-specific adaptation.
import datetime

# Derive TEST_SESSION_ID from configured HTML report path to avoid OS env deps
SESSION_ID = ""

def _derive_session_id_from_config(config: pytest.Config) -> str:
    """Extract session id from --html path like tests/reports/<ID>/html/report.html.
    Falls back to empty string if not available.
    """
    html_path = getattr(getattr(config, "option", None), "htmlpath", None)
    if not html_path:
        try:
            html_path = config.getoption("--html")
        except Exception:
            html_path = None
    if isinstance(html_path, str) and "reports/" in html_path:
        try:
            tail = html_path.split("reports/", 1)[1]
            return tail.split("/", 1)[0]
        except Exception:
            return ""
    return ""

@pytest.hookimpl(hookwrapper=True)
def pytest_runtest_makereport(item, call):
    outcome = yield
    report = outcome.get_result()
    if pytest_html:
        extras = getattr(report, "extras", [])
        summary = f"{report.nodeid}::{report.when} -> {report.outcome}"
        extras.append(pytest_html.extras.text(summary, name="result"))
        report.extras = extras

def pytest_html_results_summary(prefix, summary, postfix):
    prefix.extend([f"<p>TEST_SESSION_ID: {SESSION_ID or 'N/A'}</p>"])

def pytest_html_duration_format(duration):
    duration_timedelta = datetime.timedelta(seconds=duration)
    time = datetime.datetime(1, 1, 1) + duration_timedelta
    return time.strftime("%H:%M:%S")

def pytest_configure(config):
    global SESSION_ID
    SESSION_ID = _derive_session_id_from_config(config)
    if metadata_key is not None:
        config.stash[metadata_key]["TEST_SESSION_ID"] = SESSION_ID

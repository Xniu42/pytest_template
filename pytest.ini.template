[pytest]
minversion = 8.0
asyncio_mode = auto

# --- Paths to be dynamically set by agent ---
testpaths = [TEST_PATHS]
pythonpath = [PYTHON_PATH]

generate_report_on_test = True
render_collapsed = failed,error
addopts = 
    -v 
    --tb=short 
    --strict-markers 
    --strict-config
    --html=tests/reports/[TEST_SESSION_ID]/html/report.html
    --self-contained-html
    --junit-xml=tests/reports/[TEST_SESSION_ID]/junit/report.xml
    
    # --- Coverage path to be dynamically set by agent ---
    --cov=[COVERAGE_PATH] 
    --cov-report=term-missing 
    --cov-report=html:tests/reports/[TEST_SESSION_ID]/coverage_html 
    --cov-report=xml:tests/reports/[TEST_SESSION_ID]/coverage/coverage.xml 
    --cov-fail-under=80
markers =
    unit: Unit
    integration: Integration
    e2e: E2E
    slow: Slow
    api: API
    crud: CRUD
    auth: Auth
    db: DB
